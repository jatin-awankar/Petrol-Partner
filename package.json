{
  "name": "petrol-partner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/assert-runtime.mjs",
    "runtime:check": "node scripts/assert-runtime.mjs --exact",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present",
    "test:integration": "npm --workspace @petrol-partner/api run test:integration",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:all",
    "build:all": "npm run build && npm run build --workspaces --if-present",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:inventory": "node scripts/db-inventory.mjs",
    "db:rehearse": "node scripts/db-rehearsal.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "worker:dev": "npm --prefix apps/worker run dev",
    "worker:build": "npm --prefix apps/worker run build",
    "smoke:staging": "node scripts/staging-smoke-express.mjs",
    "auth:feasibility": "node scripts/auth-feasibility-report.mjs docs/operations/managed-auth-evidence.json",
    "auth:feasibility:live": "node --env-file=.env.auth-feasibility.local scripts/managed-auth-live.mjs",
    "auth:feasibility:application": "node --env-file=.env.auth-feasibility.local scripts/managed-auth-application-proof.mjs"
  },
  "dependencies": {
    "@mapbox/search-js-react": "1.5.0",
    "@prisma/client": "6.18.0",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.75.1",
    "@tanstack/react-query": "5.90.5",
    "@vercel/analytics": "1.6.1",
    "bcrypt": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.2.3",
    "framer-motion": "12.23.24",
    "jsonwebtoken": "9.0.2",
    "jwt-decode": "4.0.0",
    "lottie-react": "2.4.1",
    "lucide-react": "0.540.0",
    "mapbox-gl": "3.14.0",
    "motion": "12.23.12",
    "next": "16.1.1",
    "next-themes": "0.4.6",
    "pg": "8.16.3",
    "prisma": "6.18.0",
    "razorpay": "2.9.6",
    "react": "19.2.3",
    "react-day-picker": "9.9.0",
    "react-dom": "19.2.3",
    "react-loading-skeleton": "3.5.0",
    "socket.io-client": "4.8.1",
    "sonner": "2.0.7",
    "svix": "1.74.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "vaul": "1.1.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.12",
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mapbox-gl": "3.4.1",
    "@types/node": "20.19.11",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.33.0",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.7",
    "typescript": "5.9.2"
  }
}
