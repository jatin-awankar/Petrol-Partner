NODE_ENV=development
TEST_DATABASE_DISPOSABLE=true
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/petrol_partner_test
ACCESS_TOKEN_SECRET=local-access-token-secret-change-before-sharing
REFRESH_TOKEN_SECRET=local-refresh-token-secret-change-before-sharing
